{
  "description": "A fully responsive SPA built with React, Next.js, TypeScript and Tailwind CSS following the best practices of code, performance and acessibility.",
  "name": "my-portfolio",
  "version": "1.0.0",
  "keywords": [
    "react",
    "next.js",
    "typescript",
    "tailwind",
    "jest",
    "react-testing-library",
    "cypress",
    "vercel"
  ],
  "homepage": "https://github.com/DanielJXavier/my-portfolio#readme",
  "bugs": {
    "url": "https://github.com/DanielJXavier/my-portfolio/issues"
  },
  "license": "UNLICENSED",
  "author": {
    "name": "Daniel Xavier",
    "email": "dxdanielxavier@gmail.com",
    "url": "https://www.danielxavier.dev/en"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DanielJXavier/my-portfolio.git"
  },
  "scripts": {
    "dev": "next dev",
    "lint": "eslint .",
    "test": "jest",
    "test:update": "jest --updateSnapshot",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "cy:prepare": "yarn build && yarn start",
    "cy:open": "cypress open",
    "cy:run": "cypress run --browser chrome",
    "cy:update": "yarn cy:run --env updateSnapshots=true,failureThreshold=0",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@formatjs/intl-localematcher": "^0.9.0",
    "@simonsmith/cypress-image-snapshot": "^11.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "cypress": "^16.2.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "negotiator": "^1.1.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">=24.22",
    "yarn": "^4.18.1"
  },
  "private": true,
  "packageManager": "yarn@4.18.1"
}
